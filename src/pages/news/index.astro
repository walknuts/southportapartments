---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="News" description="Updates from Southport Apartments">
  <article class="container container--prose news">
    <header><h1>News</h1></header>
    {
      posts.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <ul class="news__list">
          {posts.map((p) => (
            <li class="news__item">
              <time datetime={p.data.date.toISOString()}>
                {p.data.date.toLocaleDateString("en-AU", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <h2>
                <a href={`/news/${p.id}`}>{p.data.title}</a>
              </h2>
              <p>{p.data.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</Base>

<style>
  .news {
    padding-block: var(--space-7);
  }
  .news__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
  }
  .news__item time {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--fs-300);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .news__item h2 {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--fs-600);
  }
  .news__item a {
    color: inherit;
    text-decoration: none;
  }
  .news__item a:hover {
    color: var(--color-accent);
  }
</style>
