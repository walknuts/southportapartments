---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { url } from "../lib/url";
---

<Base title="Page not found">
  <Hero />
  <article
    class="container container--prose"
    style="padding-block: var(--space-9); text-align: center;"
  >
    <h1>Page not found</h1>
    <p>That page isn't here. Try the <a href={url("/")}>home page</a> or use the navigation above.</p>
  </article>
</Base>
