---
import { Image } from "astro:assets";
import banner from "../assets/images/home/banner.jpg";

interface Props {
  image?: ImageMetadata;
  alt?: string;
  priority?: boolean;
}
const { image = banner, alt = "", priority = true } = Astro.props;
---

<div class="page-hero">
  <Image
    src={image}
    alt={alt}
    widths={[800, 1400, 2000]}
    sizes="100vw"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
  />
</div>

<style>
  .page-hero img {
    width: 100%;
    max-height: 60vh;
    object-fit: cover;
  }
</style>
