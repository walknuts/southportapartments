---
import { url } from "../lib/url";

const items = [
  { path: "about", label: "About" },
  { path: "visiting", label: "Visiting" },
  { path: "my-home", label: "My Home" },
  { path: "community", label: "Community" },
  { path: "moving-in", label: "Moving In" },
  { path: "safety", label: "Safety" },
  { path: "news", label: "News" },
  { path: "contact", label: "Contact" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (path: string) => current === url(path).replace(/\/$/, "");
---

<nav class="nav" aria-label="Primary">
  <a class="nav__brand" href={url("/")}>Southport Apartments</a>
  <input id="nav-toggle" class="nav__toggle" type="checkbox" aria-label="Open menu" />
  <label for="nav-toggle" class="nav__burger" aria-hidden="true">
    <span></span><span></span><span></span>
  </label>
  <ul class="nav__list">
    {
      items.map((it) => (
        <li>
          <a href={url(it.path)} aria-current={isCurrent(it.path) ? "page" : undefined}>
            {it.label}
          </a>
        </li>
      ))
    }
  </ul>
  <form class="nav__search" role="search" method="get" action={url("search")}>
    <label class="visually-hidden" for="nav-search">Search the site</label>
    <input
      id="nav-search"
      class="nav__search-input"
      type="search"
      name="q"
      placeholder="Search"
      autocomplete="off"
    />
  </form>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-4) var(--container-pad);
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    font-size: var(--fs-500);
  }

  .nav__list {
    list-style: none;
    padding: 0;
    margin: 0 0 0 auto;
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .nav__list a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--fs-400);
  }

  .nav__list a[aria-current="page"] {
    color: var(--color-accent-ink);
    border-bottom: 2px solid var(--color-accent);
  }

  .nav__search {
    display: flex;
  }

  .nav__search-input {
    font: inherit;
    font-size: var(--fs-300);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: inherit;
    inline-size: 14ch;
    transition:
      border-color 120ms ease,
      inline-size 160ms ease;
  }

  .nav__search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    inline-size: 20ch;
  }

  .nav__toggle,
  .nav__burger {
    display: none;
  }

  @media (width <= 720px) {
    .nav {
      flex-wrap: wrap;
    }

    .nav__burger {
      display: inline-flex;
      flex-direction: column;
      gap: 4px;
      margin-inline-start: auto;
      cursor: pointer;
      padding: var(--space-2);
    }

    .nav__burger span {
      width: 22px;
      height: 2px;
      background: var(--color-text);
      border-radius: 2px;
    }

    .nav__list {
      flex-basis: 100%;
      flex-direction: column;
      gap: var(--space-3);
      margin: 0;
      padding: var(--space-3) 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 200ms ease;
    }

    .nav__toggle:checked ~ .nav__list {
      max-height: 60vh;
    }

    .nav__search {
      flex-basis: 100%;
      order: 3;
    }

    .nav__search-input {
      inline-size: 100%;
    }

    .nav__search-input:focus {
      inline-size: 100%;
    }
  }
</style>
