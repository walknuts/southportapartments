---
import Base from "./Base.astro";
import Hero from "../components/Hero.astro";

interface Props {
  title: string;
  summary?: string;
  heroImage?: ImageMetadata;
}
const { title, summary, heroImage } = Astro.props;
const dashed = (s?: string) =>
  s?.replace(/ --- /g, " — ").replace(/---/g, "—").replace(/(\s)--(\s)/g, "$1–$2");
const renderedSummary = dashed(summary);
---

<Base title={title} description={renderedSummary} ogImage={heroImage}>
  <Hero image={heroImage} />
  <article class="container container--prose page">
    <header class="page__header">
      <h1>{title}</h1>
      {renderedSummary && <p class="page__summary">{renderedSummary}</p>}
    </header>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .page {
    padding-block: var(--space-7);
  }

  .page__header {
    margin-bottom: var(--space-6);
  }

  .page__summary {
    color: var(--color-text-muted);
    font-size: var(--fs-500);
    max-inline-size: 60ch;
  }

  .prose :global(figure) {
    margin-block: var(--space-6);
  }

  .prose :global(img) {
    border-radius: var(--radius-sm);
  }

  .prose :global(h2) {
    margin-top: var(--space-7);
  }

  .prose :global(h3) {
    margin-top: var(--space-6);
  }

  .prose :global(.data-footnote-backref) {
    display: none;
  }

  .prose :global(p:has(> em:only-child)) {
    font-size: var(--fs-300);
    color: var(--color-text-muted);
    margin-top: calc(-1 * var(--space-3));
  }

  .prose :global(p.is-source) {
    font-size: 0.78rem;
    color: color-mix(in oklab, var(--color-text-muted) 70%, transparent);
    letter-spacing: 0.01em;
  }

  .prose :global(details.appliance) {
    border-block: 1px solid var(--color-rule);
    padding: var(--space-3) 0;
    margin-block: 0;
  }

  .prose :global(details.appliance + details.appliance) {
    border-block-start: 0;
    padding-block-start: 0;
    margin-block-start: calc(-1 * var(--space-3));
  }

  .prose :global(details.appliance > summary) {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--fs-600);
    font-weight: 600;
    line-height: var(--lh-tight);
    color: #2f2c38;
    list-style: none;
    padding-inline-start: 1.5rem;
    position: relative;
  }

  .prose :global(details.appliance > summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(details.appliance > summary::before) {
    content: "›";
    position: absolute;
    inset-inline-start: 0;
    color: var(--color-text-muted);
    transition: transform 160ms ease;
    transform-origin: 0.3em 0.55em;
  }

  .prose :global(details.appliance[open] > summary::before) {
    transform: rotate(90deg);
  }

  .prose :global(details.appliance[open] > summary) {
    margin-block-end: var(--space-4);
  }
</style>
